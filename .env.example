# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose to the browser. Used only in lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build absolute links (e.g. RSVP edit links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — email notifications (Resend: https://resend.com, free tier).
# Leave unset and the app runs fine; notification emails just get logged to
# the server console instead of sent. See lib/email/.
RESEND_API_KEY=
EMAIL_FROM="InviteFlow <onboarding@resend.dev>"

# Optional — real payments (Moyasar: https://moyasar.com). Leave unset and
# ticket purchases use Mock Payment (instant, no real charge). See
# lib/payments/moyasar-provider.ts and app/api/webhooks/moyasar/route.ts.
# MOYASAR_SECRET_KEY comes from the Moyasar dashboard's API keys page.
# MOYASAR_WEBHOOK_SECRET is a token YOU pick and set in the same place when
# configuring the webhook URL (https://<your-domain>/api/webhooks/moyasar).
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Optional — WhatsApp notifications (Meta WhatsApp Cloud API, free tier via
# Meta for Developers → WhatsApp product). Leave unset and notifications
# just get logged instead of sent. See lib/whatsapp/.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Optional — error monitoring (Sentry: https://sentry.io, free tier).
# Leave unset and Sentry.init() no-ops; the app behaves identically. See
# sentry.*.config.ts and instrumentation.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time for readable stack
# traces in the Sentry dashboard — from Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
