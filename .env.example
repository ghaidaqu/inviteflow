# Supabase project settings (Project Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose to the browser. Used only in lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build absolute links (e.g. RSVP edit links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — email notifications (Resend: https://resend.com, free tier).
# Leave unset and the app runs fine; notification emails just get logged to
# the server console instead of sent. See lib/email/.
RESEND_API_KEY=
EMAIL_FROM="InviteFlow <onboarding@resend.dev>"

# Optional — WhatsApp notifications (Meta WhatsApp Cloud API, free tier via
# Meta for Developers → WhatsApp product). Leave unset and notifications
# just get logged instead of sent. See lib/whatsapp/.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Needed only for guests to accept/decline a digital invitation entirely
# inside WhatsApp (tappable buttons) — see app/api/webhooks/whatsapp/route.ts.
# WHATSAPP_VERIFY_TOKEN: a value YOU pick, entered in Meta's webhook setup.
# WHATSAPP_APP_SECRET: from Meta for Developers → App Settings → Basic.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional — error monitoring (Sentry: https://sentry.io, free tier).
# Leave unset and Sentry.init() no-ops; the app behaves identically. See
# sentry.*.config.ts and instrumentation.ts.
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time for readable stack
# traces in the Sentry dashboard — from Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional — required only to enable scheduled reminders (day-before/
# day-after WhatsApp messages to confirmed guests, see
# app/api/cron/reminders/route.ts). A value YOU pick; whatever external
# scheduler you point at that URL must send it back as
# `Authorization: Bearer <value>` (or `?secret=<value>`). Leave unset and
# the endpoint just rejects every call — reminders stay scheduled but
# never send, nothing else in the app is affected.
CRON_SECRET=
